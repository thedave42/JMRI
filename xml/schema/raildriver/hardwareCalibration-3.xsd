<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet href="../schema2xhtml.xsl" type="text/xsl"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rd="http://jmri.org/xml/schema/raildriver/3"
           targetNamespace="http://jmri.org/xml/schema/raildriver/3"
           elementFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      Per-machine HID byte calibration detents for the RailDriver Modern Desktop.
      Stored in the private (per-node) AuxiliaryConfiguration space.
    </xs:documentation>
    <xs:appinfo>
      <jmri:usingclass xmlns:jmri="http://jmri.org/xml/schema/JMRIschema"
                        configurexml="false">jmri.jmrit.usb.RailDriverPreferencesManager</jmri:usingclass>
    </xs:appinfo>
  </xs:annotation>

  <xs:element name="hardwareCalibration">
    <xs:complexType>
      <xs:all>
        <xs:element name="reverser" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="forward" type="rd:byteType" minOccurs="0"/>
              <xs:element name="neutral" type="rd:byteType" minOccurs="0"/>
              <xs:element name="reverse" type="rd:byteType" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
        <xs:element name="throttle" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="fullThrottle" type="rd:byteType" minOccurs="0"/>
              <xs:element name="idleLow" type="rd:byteType" minOccurs="0"/>
              <xs:element name="idleHigh" type="rd:byteType" minOccurs="0"/>
              <xs:element name="fullDynBrake" type="rd:byteType" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
        <xs:element name="autoBrake" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="released" type="rd:byteType" minOccurs="0"/>
              <xs:element name="sup" type="rd:byteType" minOccurs="0"/>
              <xs:element name="cs" type="rd:byteType" minOccurs="0"/>
              <xs:element name="emg" type="rd:byteType" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
        <xs:element name="indepBrake" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="fullRelease" type="rd:byteType" minOccurs="0"/>
              <xs:element name="fullApplication" type="rd:byteType" minOccurs="0"/>
              <xs:element name="bailoffRest" type="rd:byteType" minOccurs="0"/>
              <xs:element name="bailoffPressed" type="rd:byteType" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
        <xs:element name="wiper" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="off" type="rd:byteType" minOccurs="0"/>
              <xs:element name="slow" type="rd:byteType" minOccurs="0"/>
              <xs:element name="full" type="rd:byteType" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
        <xs:element name="lights" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="off" type="rd:byteType" minOccurs="0"/>
              <xs:element name="dim" type="rd:byteType" minOccurs="0"/>
              <xs:element name="full" type="rd:byteType" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="byteType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
