<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet href="../schema2xhtml.xsl" type="text/xsl"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rd="http://jmri.org/xml/schema/raildriver/3"
           targetNamespace="http://jmri.org/xml/schema/raildriver/3"
           elementFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      EngineDriver-aligned semi-realistic throttle settings for the
      RailDriver integration. Stored in the shared (profile-wide)
      AuxiliaryConfiguration space.
    </xs:documentation>
    <xs:appinfo>
      <jmri:usingclass xmlns:jmri="http://jmri.org/xml/schema/JMRIschema"
                        configurexml="false">jmri.jmrit.usb.RailDriverPreferencesManager</jmri:usingclass>
    </xs:appinfo>
  </xs:annotation>

  <xs:element name="semiRealistic">
    <xs:complexType>
      <xs:all>
        <xs:element name="enabled" type="xs:boolean" minOccurs="0"/>
        <xs:element name="baseAccelDelayMs" type="xs:positiveInteger" minOccurs="0"/>
        <xs:element name="baseDecelDelayMs" type="xs:positiveInteger" minOccurs="0"/>
        <xs:element name="minEmitIntervalMs" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="numberOfBrakeSteps" type="xs:positiveInteger" minOccurs="0"/>
        <xs:element name="airLineRechargePcnt" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="airRefreshRateMs" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="airReservoirReplenishPcnt" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="dynBrakeMinSpeedStep" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="numberOfLoadSteps" type="xs:positiveInteger" minOccurs="0"/>
        <xs:element name="maxLoadPcnt" type="xs:positiveInteger" minOccurs="0"/>
        <xs:element name="loadSliderPosition" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="decoderBrakeMode" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="none"/>
              <xs:enumeration value="ESU"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="esuLowFunction" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="esuMidFunction" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="esuHighFunction" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="esuLowThreshold" type="rd:percentType" minOccurs="0"/>
        <xs:element name="esuMidThreshold" type="rd:percentType" minOccurs="0"/>
        <xs:element name="esuHighThreshold" type="rd:percentType" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="percentType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
